APP_NAME="Marine Ops"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados: PostgreSQL (Neon).
# Cole aqui a connection string do painel do Neon, por exemplo:
# postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require&channel_binding=require
DB_CONNECTION=pgsql
DATABASE_URL=

# Origem(ns) do frontend liberadas no CORS (separe várias com vírgula)
FRONTEND_URL=http://localhost:8080

# Validade dos tokens de acesso da API, em minutos (padrão: 7 dias)
SANCTUM_EXPIRATION=10080

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
